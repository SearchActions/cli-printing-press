// The MCP server is a local subprocess, not an HTTP endpoint: this CLI starts
// it, speaks newline-delimited JSON-RPC over its stdin and stdout, and stops it
// when the process exits. Only the round trip differs from the HTTP transport;
// the lifecycle, tool routing, argument coercion, and result unwrapping in
// mcp.go are shared.

// mcpStdioCommand is the executable this CLI launches, with its arguments.
// Recorded from the server at capture time rather than assumed, because the
// launcher is per-server: a Python server ships as `uvx <pkg>`, a Node one as
// `npx <pkg>`, and a server with a broken upstream dependency pin needs that
// pin here.
var (
	mcpStdioCommand = {{printf "%q" .MCPStdio.Command}}
	mcpStdioArgs    = []string{
{{- range .MCPStdio.Args}}
		{{printf "%q" .}},
{{- end}}
	}
)

// MCPStdioForwardEnv names the environment variables the server reads. They are
// forwarded from this process's environment; the values are the operator's and
// are never compiled in.
var MCPStdioForwardEnv = []string{
{{- range .MCPStdio.Env}}
	{{printf "%q" .}},
{{- end}}
}

{{if .MCPStdio.Ready}}
// MCPStdioReadyTool is the read-only tool doctor calls to prove the server and
// its local prerequisites actually work. A stdio server has no URL to ping, so
// this call is the only real health signal.
const MCPStdioReadyTool = {{printf "%q" .MCPStdio.Ready}}
{{end}}

// MCPCommandEnvVar overrides the launch command, as a whitespace-separated
// command line. It exists so a test harness can substitute a scripted server
// the way an HTTP CLI's base-URL env var redirects an HTTP CLI at a mock, and so an
// operator who installed the server under a different name is not blocked.
const MCPCommandEnvVar = "{{envPrefix .Name}}_MCP_COMMAND"

// maxStdioLine bounds one JSON-RPC line. Tool results are legitimately large
// (a crawl export, a document set), so the ceiling is generous; without one, a
// server streaming unbounded output would exhaust memory.
const maxStdioLine = 32 << 20

// mcpProcess is the running server. It is package-level for the same reason the
// HTTP session is: Client comes from the shared template and cannot grow
// per-transport fields, and one CLI invocation talks to one server.
var mcpProcess struct {
	sync.Mutex
	cmd     *exec.Cmd
	stdin   io.WriteCloser
	stdout  *bufio.Reader
	nextID  int64
	started bool
	err     error

	stderrMu  sync.Mutex
	stderrLog strings.Builder
}

// mcpStdioLaunchCommand resolves the command to run, honoring the override.
func mcpStdioLaunchCommand() (string, []string) {
	if override := strings.TrimSpace(os.Getenv(MCPCommandEnvVar)); override != "" {
		parts := strings.Fields(override)
		return parts[0], parts[1:]
	}
	return mcpStdioCommand, mcpStdioArgs
}

// ensureMCPProcess starts the server on first use.
//
// Lazy rather than eager: --help, version, and any command that never reaches
// the transport must not pay process startup, and must not fail on a machine
// where the server is not installed at all.
func ensureMCPProcess() error {
	mcpProcess.Lock()
	defer mcpProcess.Unlock()
	if mcpProcess.started {
		return mcpProcess.err
	}
	mcpProcess.started = true

	name, args := mcpStdioLaunchCommand()
	// exec.Command, not a shell: command and arguments are passed as a vector,
	// so a recorded value containing a space or a semicolon stays one argument
	// instead of becoming another command.
	cmd := exec.Command(name, args...)
	cmd.Env = mcpStdioEnv()

	stdin, err := cmd.StdinPipe()
	if err != nil {
		mcpProcess.err = fmt.Errorf("opening stdin for %s: %w", name, err)
		return mcpProcess.err
	}
	stdout, err := cmd.StdoutPipe()
	if err != nil {
		mcpProcess.err = fmt.Errorf("opening stdout for %s: %w", name, err)
		return mcpProcess.err
	}
	stderr, err := cmd.StderrPipe()
	if err != nil {
		mcpProcess.err = fmt.Errorf("opening stderr for %s: %w", name, err)
		return mcpProcess.err
	}
	if err := cmd.Start(); err != nil {
		mcpProcess.err = fmt.Errorf("starting the MCP server (%s): %w\n\nInstall it, or point %s at a working launch command.", name, err, MCPCommandEnvVar)
		return mcpProcess.err
	}

	mcpProcess.cmd = cmd
	mcpProcess.stdin = stdin
	mcpProcess.stdout = bufio.NewReaderSize(stdout, 1<<20)
	// Drain stderr continuously. Left unread, a chatty server fills the pipe
	// buffer and blocks on its next log line, which reads as a hung call.
	go drainMCPStderr(stderr)
	return nil
}

// mcpStdioEnv builds the child environment: this process's, which already
// carries the forwarded names. They are listed so the generated docs and
// doctor can report what the server needs.
func mcpStdioEnv() []string {
	return os.Environ()
}

func drainMCPStderr(r io.Reader) {
	scanner := bufio.NewScanner(r)
	scanner.Buffer(make([]byte, 0, 64<<10), 1<<20)
	for scanner.Scan() {
		mcpProcess.stderrMu.Lock()
		if mcpProcess.stderrLog.Len() > 64<<10 {
			mcpProcess.stderrLog.Reset()
		}
		mcpProcess.stderrLog.WriteString(scanner.Text())
		mcpProcess.stderrLog.WriteByte('\n')
		mcpProcess.stderrMu.Unlock()
	}
}

func mcpStderrTail() string {
	mcpProcess.stderrMu.Lock()
	defer mcpProcess.stderrMu.Unlock()
	return strings.TrimSpace(mcpProcess.stderrLog.String())
}

// mcpRoundTrip sends one JSON-RPC request to the child and returns the raw
// envelope. Signature-identical to the HTTP transport's, so mcp.go is shared.
//
// The status code is synthetic: stdio has no HTTP status, and callers only
// compare it against success. headers are ignored — a subprocess has no
// request headers, and a stdio server authenticates with nothing.
func (c *Client) mcpRoundTrip(ctx context.Context, req any, _ map[string]string, readOnly bool) (json.RawMessage, int, error) {
	// The verify-mode mutation gate lives in the HTTP client's doInternal,
	// which this transport bypasses, so it is applied here instead. Without
	// it, a verify run would execute real mutations against the operator's
	// own machine — the blast radius stdio makes larger, not smaller.
	//
	// Deliberately NOT gated on VerifyLiveHTTPEnvVar, which the HTTP client
	// honors and which verify sets on every mock-mode subprocess. That var
	// means "verify owns an httptest mock server, so let the real wire path
	// run against it." There is no mock subprocess: honoring it here would
	// send the mutation to the operator's own machine, which is precisely
	// what this gate exists to prevent. Live runners (live_dogfood,
	// workflow_verify) strip PRINTING_PRESS_VERIFY itself, so real-API
	// dogfood still exercises mutations.
	if !readOnly && cliutil.IsVerifyEnv() {
		return json.RawMessage(`{"result":{"content":[],"verify_noop":true,"success":false}}`), 200, nil
	}

	if err := ensureMCPProcess(); err != nil {
		return nil, 0, err
	}

	mcpProcess.Lock()
	defer mcpProcess.Unlock()

	mcpProcess.nextID++
	id := mcpProcess.nextID
	payload, err := mcpStdioPayload(req, id)
	if err != nil {
		return nil, 0, err
	}
	if _, err := mcpProcess.stdin.Write(append(payload, '\n')); err != nil {
		return nil, 0, mcpStdioError(err)
	}

	// Skip notifications and replies to other ids: a server may interleave log
	// notifications with the reply being awaited.
	for {
		if err := ctx.Err(); err != nil {
			return nil, 0, err
		}
		line, err := readMCPLine()
		if err != nil {
			return nil, 0, mcpStdioError(err)
		}
		var probe struct {
			ID *int64 `json:"id"`
		}
		if err := json.Unmarshal(line, &probe); err != nil {
			// Not JSON: a server that printed a banner to stdout. The real
			// reply may still follow.
			continue
		}
		if probe.ID == nil || *probe.ID != id {
			continue
		}
		return json.RawMessage(line), 200, nil
	}
}

// mcpStdioPayload stamps the request with the id this transport is waiting on.
// The shared lifecycle code assigns ids from its own counter; over stdio the
// reply must be matched to the write, so this counter is authoritative.
func mcpStdioPayload(req any, id int64) ([]byte, error) {
	encoded, err := json.Marshal(req)
	if err != nil {
		return nil, fmt.Errorf("encoding MCP request: %w", err)
	}
	var fields map[string]json.RawMessage
	if err := json.Unmarshal(encoded, &fields); err != nil {
		return encoded, nil
	}
	// A notification carries no id and must not gain one: adding one turns it
	// into a request the server is obliged to answer, and the reply would be
	// read as the answer to the next real call.
	if _, isNotification := fields["id"]; !isNotification {
		return encoded, nil
	}
	fields["id"] = json.RawMessage(fmt.Sprintf("%d", id))
	return json.Marshal(fields)
}

// mcpNotify sends a JSON-RPC notification: no id, no response expected.
func (c *Client) mcpNotify(_ context.Context, payload any, _ map[string]string) {
	if err := ensureMCPProcess(); err != nil {
		return
	}
	mcpProcess.Lock()
	defer mcpProcess.Unlock()
	encoded, err := json.Marshal(payload)
	if err != nil {
		return
	}
	_, _ = mcpProcess.stdin.Write(append(encoded, '\n'))
}

func readMCPLine() ([]byte, error) {
	var buf []byte
	for {
		chunk, isPrefix, err := mcpProcess.stdout.ReadLine()
		if err != nil {
			return nil, err
		}
		buf = append(buf, chunk...)
		if len(buf) > maxStdioLine {
			return nil, fmt.Errorf("response line exceeded %d bytes", maxStdioLine)
		}
		if !isPrefix {
			return buf, nil
		}
	}
}

// mcpStdioError turns a broken pipe into the actionable failure it really is.
// A server that dies on startup — a missing dependency, a bad interpreter, an
// uninstalled prerequisite — otherwise reports only "broken pipe", naming the
// symptom while the cause sits in the child's stderr.
func mcpStdioError(err error) error {
	if tail := mcpStderrTail(); tail != "" {
		return fmt.Errorf("MCP server failed: %w\n\nserver output:\n%s", err, tail)
	}
	return fmt.Errorf("MCP server failed: %w", err)
}

// ShutdownMCP stops the server. Closing stdin is the MCP shutdown signal; a
// well-behaved server exits on EOF, and Kill covers the ones that do not.
func ShutdownMCP() {
	mcpProcess.Lock()
	defer mcpProcess.Unlock()
	if !mcpProcess.started || mcpProcess.cmd == nil {
		return
	}
	if mcpProcess.stdin != nil {
		_ = mcpProcess.stdin.Close()
	}
	if mcpProcess.cmd.Process != nil {
		_ = mcpProcess.cmd.Process.Kill()
	}
	_ = mcpProcess.cmd.Wait()
}

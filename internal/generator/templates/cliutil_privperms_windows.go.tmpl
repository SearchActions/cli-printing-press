// Write-time half of the private-file permission contract. The read-time
// guard in creds_perms_windows.go refuses a credentials file whose DACL
// grants anyone beyond the owner/SYSTEM; Chmod is a no-op on NTFS, so the
// only way a written file can satisfy that guard is to be CREATED with an
// explicit protected DACL. Attaching the descriptor at create time leaves
// no window where the file exists with inherited ACEs and no path-swap
// race a by-name stamp would have.
package cliutil

import (
	"errors"
	"fmt"
	"math/rand/v2"
	"os"
	"path/filepath"
	"strconv"
	"sync"
	"unsafe"

	"golang.org/x/sys/windows"
)

var (
	privWarnedMu sync.Mutex
	privWarned   = map[string]struct{}{}
)

// processUserSID returns the current process's user SID as an SDDL string.
func processUserSID() (string, error) {
	tok, err := windows.OpenCurrentProcessToken()
	if err != nil {
		return "", err
	}
	defer tok.Close()
	u, err := tok.GetTokenUser()
	if err != nil {
		return "", err
	}
	return u.User.Sid.String(), nil
}

// createPrivateTemp is os.CreateTemp with a protected owner+SYSTEM DACL:
// the file never inherits the parent directory's ACEs, whatever host or
// volume the directory lives on. SYSTEM keeps scheduled tasks and OS-level
// backup working while granting nothing it cannot already take.
func createPrivateTemp(dir, base string) (*os.File, error) {
	sid, err := processUserSID()
	var sd *windows.SECURITY_DESCRIPTOR
	if err == nil {
		sd, err = windows.SecurityDescriptorFromString("D:P(A;;FA;;;" + sid + ")(A;;FA;;;SY)")
	}
	if err != nil {
		// On a volume that can store ACLs, a file created without a
		// descriptor inherits the parent's principals and every perms
		// check will refuse it — fail loudly instead. On a volume with
		// no ACL support (exFAT/FAT32/drvfs/some SMB) there is nothing
		// to protect, so warn once and fall back.
		if volumeHasPersistentACLs(dir) {
			return nil, fmt.Errorf("building private-file security descriptor: %w", err)
		}
		warnNoPrivatePerms(dir, err)
		return os.CreateTemp(dir, "."+base+".*.tmp")
	}
	sa := &windows.SecurityAttributes{
		Length:             uint32(unsafe.Sizeof(windows.SecurityAttributes{})),
		SecurityDescriptor: sd,
	}
	prefix, suffix := "."+base+".", ".tmp"
	for try := 0; try < 10000; try++ {
		name := filepath.Join(dir, prefix+strconv.FormatUint(uint64(rand.Uint32()), 10)+suffix)
		ptr, err := windows.UTF16PtrFromString(name)
		if err != nil {
			return nil, err
		}
		h, err := windows.CreateFile(ptr,
			windows.GENERIC_READ|windows.GENERIC_WRITE,
			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE,
			sa,
			windows.CREATE_NEW,
			windows.FILE_ATTRIBUTE_NORMAL,
			0)
		if err == nil {
			// FAT-family volumes accept the descriptor silently and store
			// nothing; a perms-checking reader may then refuse the file.
			// Nothing better is possible there, so say so once.
			if !volumeHasPersistentACLsByHandle(h) {
				warnNoPrivatePerms(name, errors.New("volume does not store ACLs"))
			}
			return os.NewFile(uintptr(h), name), nil
		}
		if errors.Is(err, windows.ERROR_FILE_EXISTS) || errors.Is(err, windows.ERROR_ALREADY_EXISTS) {
			continue
		}
		return nil, err
	}
	return nil, fmt.Errorf("createPrivateTemp(%s): too many attempts", dir)
}

// RestrictPrivateTree replaces dir's DACL with a protected, inheritable
// owner+SYSTEM one. Files created under it afterwards — by this CLI or by
// anything else — inherit a clean ACL, so they pass the strict read guard
// even when an ancestor directory carries foreign inherited ACEs.
func RestrictPrivateTree(dir string) error {
	sid, err := processUserSID()
	if err != nil {
		return fmt.Errorf("resolving current user SID: %w", err)
	}
	sd, err := windows.SecurityDescriptorFromString("D:P(A;OICI;FA;;;" + sid + ")(A;OICI;FA;;;SY)")
	if err != nil {
		return fmt.Errorf("building directory security descriptor: %w", err)
	}
	dacl, _, err := sd.DACL()
	if err != nil {
		return fmt.Errorf("extracting directory DACL: %w", err)
	}
	return windows.SetNamedSecurityInfo(dir, windows.SE_FILE_OBJECT,
		windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION,
		nil, nil, dacl, nil)
}

func volumeHasPersistentACLs(dir string) bool {
	root, err := filepath.Abs(filepath.VolumeName(dir) + `\`)
	if err != nil {
		return false
	}
	ptr, err := windows.UTF16PtrFromString(root)
	if err != nil {
		return false
	}
	var flags uint32
	if err := windows.GetVolumeInformation(ptr, nil, 0, nil, nil, &flags, nil, 0); err != nil {
		return false
	}
	return flags&windows.FILE_PERSISTENT_ACLS != 0
}

func volumeHasPersistentACLsByHandle(h windows.Handle) bool {
	var flags uint32
	if err := windows.GetVolumeInformationByHandle(h, nil, 0, nil, nil, &flags, nil, 0); err != nil {
		return false
	}
	return flags&windows.FILE_PERSISTENT_ACLS != 0
}

// warnNoPrivatePerms is one-shot per path: journal and config writes go
// through the same temp path as credentials, so a hot caller on a no-ACL
// volume must not spam every write.
func warnNoPrivatePerms(path string, err error) {
	privWarnedMu.Lock()
	if _, ok := privWarned[path]; ok {
		privWarnedMu.Unlock()
		return
	}
	privWarned[path] = struct{}{}
	privWarnedMu.Unlock()
	fmt.Fprintf(os.Stderr, "warning: could not restrict access to %s: %v; readers that check permissions may refuse it\n", path, err)
}

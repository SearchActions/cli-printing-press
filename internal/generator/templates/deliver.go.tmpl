}

func deliverFile(path string, body []byte) error {
	// Atomic write: tmp + rename. Protects agents from seeing a partial
	// file if the process is interrupted mid-write.
	dir := filepath.Dir(path)
	if dir != "" && dir != "." {
		if err := os.MkdirAll(dir, 0o700); err != nil {
			return fmt.Errorf("creating deliver dir: %w", err)
		}
	}
	tmp := path + ".tmp"
	if err := os.WriteFile(tmp, body, 0o600); err != nil {
		return fmt.Errorf("writing deliver tmp: %w", err)
	}
	if err := os.Rename(tmp, path); err != nil {
		return fmt.Errorf("replacing deliver file: %w", err)
	}
	return nil
}

// validateWebhookTarget is the single gate for --deliver webhook:<url>.
// It allows loopback destinations unconditionally, and every other
// origin only when it is an exact member of the deliverWebhookAllowlistEnv
// allowlist. Callers must build the outbound request from the returned
// *url.URL (never re-parse raw) and pick the transport from viaLoopback.
func validateWebhookTarget(raw string) (*url.URL, bool, error) {
	u, err := url.Parse(raw)
	if err != nil {
		return nil, false, errors.New("--deliver webhook: target is not a valid URL")
	}
	if u.Scheme != "http" && u.Scheme != "https" {
		return nil, false, errors.New("--deliver webhook: target must use http:// or https://")
	}
	if u.Host == "" {
		return nil, false, errors.New("--deliver webhook: target is missing a host")
	}
	if u.User != nil {
		return nil, false, errors.New("--deliver webhook: target must not include userinfo")
	}

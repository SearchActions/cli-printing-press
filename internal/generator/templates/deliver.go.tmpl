			return nil, fmt.Errorf("%s: entry %d: not a valid http(s) origin", deliverWebhookAllowlistEnv, i+1)
		}
		if u.User != nil {
			return nil, fmt.Errorf("%s: entry %d: must not include userinfo", deliverWebhookAllowlistEnv, i+1)
		}
		if (u.Path != "" && u.Path != "/") || u.RawQuery != "" || u.Fragment != "" {
			return nil, fmt.Errorf("%s: entry %d: must be an origin only, not a path/query/fragment", deliverWebhookAllowlistEnv, i+1)
		}
		if !isASCIIHost(u.Hostname()) {
			return nil, fmt.Errorf("%s: entry %d: host must be ASCII", deliverWebhookAllowlistEnv, i+1)
		}
		set[canonicalOrigin(u)] = true

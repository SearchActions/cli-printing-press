		return nil, false, fmt.Errorf("--deliver webhook: origin %s is not allowed (loopback is always allowed; to permit this origin set %s=%s)", origin, deliverWebhookAllowlistEnv, origin)
	}
	allowed, aerr := parseWebhookAllowlist(rawAllow)
	if aerr != nil {
		return nil, false, aerr
	}
	if !allowed[origin] {
		return nil, false, fmt.Errorf("--deliver webhook: origin %s is not allowed (loopback is always allowed; to permit this origin set %s=%s)", origin, deliverWebhookAllowlistEnv, origin)
	}
	return u, false, nil
}

// canonicalOrigin renders scheme+host+port with the host lowercased and
// the default port filled in explicitly, so allowlist comparison is exact
// string equality with no implicit-port ambiguity. The port is taken
// verbatim from the URL (never renumbered), so a leading-zero spelling
// like ":0443" never aliases ":443".
func canonicalOrigin(u *url.URL) string {
	host := strings.ToLower(u.Hostname())
	port := u.Port()
	if port == "" {
		if u.Scheme == "https" {
			port = "443"
		} else {
			port = "80"
		}
	}
	return u.Scheme + "://" + net.JoinHostPort(host, port)
}

// isLoopbackHost reports whether h (a URL hostname, no port/brackets) is
// "localhost" or a loopback IP literal. It never performs a DNS lookup,
// so a hosts-file redirect of "localhost" elsewhere does not fool it;
// the dial-time pin in rejectNonLoopback is the second, authoritative
// check for that case.
func isLoopbackHost(h string) bool {
	if strings.EqualFold(h, "localhost") {
		return true
	}
	ip := net.ParseIP(h)
	return ip != nil && ip.IsLoopback()
}

// isASCIIHost rejects hosts containing any non-ASCII byte. strings.ToLower
// and IDNA case-folding disagree on characters like fullwidth Latin
// letters; refusing them outright removes the ambiguity rather than
// trying to normalise it.
func isASCIIHost(h string) bool {
	for i := 0; i < len(h); i++ {
		if h[i] > 127 {
			return false
		}
	}
	return true
}

// parseWebhookAllowlist parses the comma-separated allowlist env value.
// Every non-empty entry must be a bare http(s) origin: no path, query,
// fragment, userinfo, or wildcard. A malformed entry fails the whole
// list closed (never silently skipped) so a typo cannot widen the
// allowlist. Entries are identified by position in error text, never by
// their raw value, since an entry may itself carry a secret.
func parseWebhookAllowlist(v string) (map[string]bool, error) {

func TestDeliverWebhook_RedactionNeverLeaksSecret(t *testing.T) {
	const secret = "SECRET-TOKEN-VALUE"

	if _, _, perr := validateWebhookTarget("webhook:%zz" + secret); perr == nil {
		t.Fatal("expected error for an unparseable URL")
	} else if strings.Contains(perr.Error(), secret) {
		t.Fatalf("malformed-URL error leaked the raw target: %v", perr)
	}

	if _, perr := ParseDeliverSink("nocolon" + secret); perr == nil {
		t.Fatal("expected error for spec with no colon")
	} else if strings.Contains(perr.Error(), secret) {
		t.Fatalf("no-colon error leaked the raw spec: %v", perr)
	}

	target := "https://evil.tld/" + secret
	_, _, verr := validateWebhookTarget(target)
	if verr == nil {
		t.Fatal("expected refusal for disallowed origin")
	}
	if strings.Contains(verr.Error(), secret) {
		t.Fatalf("refusal error leaked the secret path: %v", verr)
	}

	t.Setenv(deliverWebhookAllowlistEnv, "https://hooks.slack.com/services/T/B/"+secret)
	_, _, aerr := validateWebhookTarget("https://hooks.slack.com/")
	if aerr == nil {
		t.Fatal("expected refusal for a path-bearing allowlist entry")
	}
	if strings.Contains(aerr.Error(), secret) {
		t.Fatalf("allowlist error leaked the raw entry: %v", aerr)
	}

	if got := redactedWebhookTarget(target); strings.Contains(got, secret) {
		t.Fatalf("redactedWebhookTarget leaked the secret: %q", got)
	}
}


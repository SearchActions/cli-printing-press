func TestValidateWebhookTarget_LoopbackAndAllowlist(t *testing.T) {
	cases := []struct {
		name      string
		target    string
		allowlist string
		wantAllow bool
	}{
		{"exact origin path and query ignored", "https://hooks.example.com/x?y=1", "https://hooks.example.com", true},
		{"host case and default port normalised", "https://HOOKS.example.com:443/", "https://hooks.example.com", true},
		{"subdomain append refused", "https://hooks.example.com.evil.tld/", "https://hooks.example.com", false},
		{"label extension refused", "https://hooks.example.community/", "https://hooks.example.com", false},
		{"bare char append refused", "https://hooks.example.comx/", "https://hooks.example.com", false},
		{"prefix prepend refused", "https://evilhooks.example.com/", "https://hooks.example.com", false},
		{"userinfo trick refused", "https://hooks.example.com@evil.tld/", "https://hooks.example.com", false},
		{"userinfo on allowed host refused", "https://u:p@hooks.example.com/", "https://hooks.example.com", false},
		{"scheme is part of origin", "http://hooks.example.com/", "https://hooks.example.com", false},
		{"port is part of origin", "https://hooks.example.com:8443/", "https://hooks.example.com", false},
		{"loopback default allow ipv4", "http://127.0.0.1:9/", "", true},
		{"loopback default allow name", "http://localhost:9/", "", true},
		{"loopback default allow ipv6", "http://[::1]:9/", "", true},
		{"loopback lookalike subdomain refused", "http://localhost.evil.tld/", "", false},
		{"loopback lookalike nip.io refused", "http://127.0.0.1.nip.io/", "", false},
		{"0.0.0.0 refused", "http://0.0.0.0/", "", false},
		{"missing scheme refused", "hooks.example.com", "https://hooks.example.com", false},
		{"missing host refused", "https:///x", "https://hooks.example.com", false},
		{"non-http scheme refused", "ftp://hooks.example.com/", "https://hooks.example.com", false},
		{"trailing dot host refused", "http://localhost.:9/", "", false},
		{"zoned ipv6 refused", "http://[::1%25lo]:9/", "", false},
		{"short-form ipv4 refused", "http://127.1/", "", false},
		{"ipv4-mapped loopback allowed", "http://[::ffff:127.0.0.1]:9/", "", true},
		{"leading zero port does not alias 443", "https://hooks.example.com:0443/", "https://hooks.example.com", false},
		{"fullwidth host refused", "https://ｈooks.example.com/", "https://hooks.example.com", false},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			if tc.allowlist != "" {
				t.Setenv(deliverWebhookAllowlistEnv, tc.allowlist)
			}
			_, _, err := validateWebhookTarget(tc.target)
			gotAllow := err == nil
			if gotAllow != tc.wantAllow {
				t.Fatalf("validateWebhookTarget(%q) allow=%v err=%v, want allow=%v", tc.target, gotAllow, err, tc.wantAllow)
			}
		})
	}
}

